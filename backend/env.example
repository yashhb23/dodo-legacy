# ──────────────────────────────────────────────────
# DODO LEGACY — Backend Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp env.example .env
#
# In production, set these in Railway → Variables tab.
# ──────────────────────────────────────────────────

# MongoDB connection string from MongoDB Atlas
# https://cloud.mongodb.com → your cluster → Connect → Drivers → copy the connection string
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name (must match the DB created in Atlas)
DB_NAME=dodo_legacy

# CORS Origins — comma-separated list of allowed frontend origins
# Development:  http://localhost:3000
# Production:   https://dodolegacy.com,https://www.dodolegacy.com
CORS_ORIGINS=http://localhost:3000

# Admin secret key — used to protect /api/admin/* endpoints
# Set a long random string. Access the admin panel at:
#   https://dodolegacy.com/admin/comments?secret=<this value>
# Generate one at: https://randomkeygen.com
ADMIN_SECRET=change_me_to_a_long_random_string
