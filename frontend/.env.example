# ──────────────────────────────────────────────────
# DODO LEGACY — Frontend Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Variables prefixed with REACT_APP_ are embedded at
# build time by Create React App and available via
# process.env.REACT_APP_*.
# ──────────────────────────────────────────────────

# Backend API URL (required for comments, likes, admin)
# In production this is your Railway URL, e.g.:
#   https://dodo-legacy-production.up.railway.app
REACT_APP_API_URL=

# Microsoft Clarity project ID (optional — for heatmaps & session recordings)
# Sign up free at https://clarity.microsoft.com and create a project.
# Leave blank to disable.
REACT_APP_CLARITY_ID=
